HOME=Path('/home/joel'); PROFILES=HOME/'Documents/prefs/audio/camilladsp'; MUSIC=HOME/'Downloads/Music'
STATE=HOME/'.local/state/sway/audio/camilladsp-webremote'; PORT=8766
