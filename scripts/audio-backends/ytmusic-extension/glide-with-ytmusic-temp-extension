#!/usr/bin/env bash
set -euo pipefail

DIR=/home/joel/.config/sway/scripts/audio-backends/ytmusic-extension
args=(
  run
  --source-dir="$DIR"
  --firefox="$DIR/glide-rdp-browser"
  --no-reload
  --no-config-discovery
)

if (($#)); then
  args+=(--start-url "$1")
fi

exec /run/current-system/sw/bin/web-ext "${args[@]}"
